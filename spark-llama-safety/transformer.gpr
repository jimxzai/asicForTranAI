--  GNAT project for the SPARK reference code in src/ (mirrors ../kernel3p5).
--  Templates from 2025 that never compiled are kept, unproved, in legacy/ and are not part of this project.
project Transformer is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Switches ("Ada") use ("-gnatwa", "-gnat2022", "-O2");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=all", "--timeout=60");
   end Prove;
end Transformer;
